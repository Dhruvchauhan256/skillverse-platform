generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String
  role              String             @default("user")
  createdAt         DateTime           @default(now())
  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?
  gigs              Gig[]
  receivedMessages  Message[]          @relation("ReceivedMessages")
  sentMessages      Message[]          @relation("SentMessages")
  projects          Project[]
  proposals         Proposal[]
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")
}

model FreelancerProfile {
  id         String      @id @default(uuid())
  title      String
  bio        String
  skills     String
  hourlyRate Int
  country    String
  userId     String      @unique
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  portfolios Portfolio[]
}

model Portfolio {
  id           String            @id @default(uuid())
  title        String
  description  String
  imageUrl     String?
  liveUrl      String?
  githubUrl    String?
  freelancerId String
  createdAt    DateTime          @default(now())
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id])
}

model ClientProfile {
  id          String   @id @default(uuid())
  companyName String?
  description String?
  userId      String   @unique
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Gig {
  id           String   @id @default(uuid())
  title        String
  description  String
  price        Int
  category     String
  freelancerId String
  createdAt    DateTime @default(now())
  freelancer   User     @relation(fields: [freelancerId], references: [id])
}

model Project {
  id          String     @id @default(uuid())
  title       String
  description String
  budget      Int
  status      String     @default("open")
  clientId    String
  createdAt   DateTime   @default(now())
  category    String
  client      User       @relation(fields: [clientId], references: [id])
  proposals   Proposal[]
  reviews     Review[]
}

model Review {
  id            String   @id @default(uuid())
  projectId     String
  fromUserId    String
  toUserId      String
  rating        Int      // 1-5 stars
  title         String?
  description   String?
  isAnonymous   Boolean  @default(false)
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromUser      User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUser        User     @relation("ReviewsReceived", fields: [toUserId], references: [id])

  @@unique([projectId, fromUserId])
}

model Proposal {
  id           String   @id @default(uuid())
  coverLetter  String
  bidAmount    Int
  deliveryDays Int
  status       String   @default("pending")
  projectId    String
  freelancerId String
  createdAt    DateTime @default(now())
  freelancer   User     @relation(fields: [freelancerId], references: [id])
  project      Project  @relation(fields: [projectId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String?   @unique @db.Uuid
  name           String?
  title          String?
  bio            String?
  location       String?
  hourly_rate    Int?
  avatar_url     String?
  skills         String[]
  rating         Float?    @default(0)
  jobs_completed Int?      @default(0)
  earnings       Int?      @default(0)
  response_rate  Int?      @default(0)
  is_online      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  portfolio      Json?     @default("[]")
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  ranking_score  Int?      @default(0)
}